# Penny Run — served from the droplet.
#
# Caddy gets and renews the certificate on its own, which is the whole
# point: iOS will not hand the camera to a page that is not a secure
# context, so HTTPS is not optional for this app.
#
# setup.sh fills in the two placeholders.

{$PENNYRUN_HOST} {
	encode gzip zstd

	handle /api/* {
		# `POST /api/v1/discovery` accepts a batch of observations and each
		# accepted row becomes a permanent row in an append-only table --
		# there is no DELETE, no UPDATE, no TRUNCATE (db/migrations/002_
		# append_only.sql). tools/upload.py caps itself at 1000 rows a
		# request client-side, and at ~450 bytes for a worst-case row (a
		# 64-char item_id, a 64-char store_id, a 200-char name, all four
		# numeric fields at their max width) that batch is under 500KB --
		# but Caddy is the only thing standing between a client that
		# ignores that cap and a database that can't shrink back down.
		# 1MB leaves roughly double the legitimate worst case as headroom
		# while still bounding how much unrecoverable damage one request
		# can do.
		request_body {
			max_size 1MB
		}
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		root * {$PENNYRUN_ROOT}

		# Every open should pick up the current build rather than whatever
		# was cached at install time.
		@shell path / /index.html /sw.js /manifest.webmanifest
		header @shell Cache-Control "no-cache"

		# The heavy assets change only with a build, and the service worker
		# cache name carries the version, so these can sit still.
		@static path /ocr/* /zxing.min.js /stores.json /hd-stores.json /*.png
		header @static Cache-Control "public, max-age=604800"

		file_server
	}

	log {
		output file /var/log/caddy/pennyrun.log
		format console
	}
}
